<%- include('../partials/head') %>

<div class="w-full max-w-5xl mx-auto pb-16">

  <div class="mb-8">
    <a href="/homes" class="text-gray-400 hover:text-white text-sm transition duration-200">← Back to all homes</a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 mb-10">

    <div class="lg:col-span-5">
      <div class="relative bg-[#18181b] border border-[#27272a] rounded-2xl overflow-hidden">
        <img src="<%= home.photo_url %>" alt="<%= home.name %>" class="w-full aspect-4/3 object-cover" />
        <div class="absolute top-4 right-4 bg-red-600 text-white text-sm font-bold px-3 py-1 rounded-full">
          ⭐ <%= home.rating %>
        </div>
      </div>
    </div>

    <div class="lg:col-span-7 flex flex-col">
      <h1 class="text-4xl font-bold text-white mb-2"><%= home.name %></h1>
      <p class="text-gray-400 text-lg mb-6">📍 <%= home.location %></p>

      <hr class="border-[#27272a] mb-6" />

      <div class="mb-8">
        <p class="text-gray-400 text-sm mb-1">Price per night</p>
        <div class="flex items-baseline gap-2">
          <span class="text-4xl font-bold text-white">$<%= home.price_per_night %></span>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 mt-auto">
        <button class="flex-1 bg-red-600 hover:bg-red-700 text-white font-semibold py-3.5 rounded-xl transition duration-200">
          Book Now
        </button>
        <div class="flex-1">
          <%- include('../partials/favourite.ejs', { home }) %>
        </div>
      </div>
    </div>

  </div>

  <hr class="border-[#27272a] mb-10" />

  <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

    <div class="md:col-span-1 flex flex-col gap-4">
      <div class="bg-[#18181b] border border-[#27272a] rounded-xl p-5">
        <p class="text-gray-400 text-xs mb-1">Guest rating</p>
        <p class="text-white text-xl font-bold"><%= home.rating %> <span class="text-yellow-400">★</span></p>
      </div>
      <div class="bg-[#18181b] border border-[#27272a] rounded-xl p-5">
        <p class="text-gray-400 text-xs mb-1">Location</p>
        <p class="text-white font-semibold"><%= home.location %></p>
      </div>
      <div class="bg-[#18181b] border border-[#27272a] rounded-xl p-5">
        <p class="text-gray-400 text-xs mb-1">Home ID</p>
        <p class="text-white font-semibold">#<%= home._id %></p>
      </div>
    </div>

    <div class="md:col-span-2">
      <h2 class="text-xl font-bold text-white mb-4">About this place</h2>
      <div class="bg-[#18181b] border border-[#27272a] rounded-xl p-6 h-[calc(100%-2.5rem)]">
        <p class="text-gray-300 text-base leading-relaxed">
          <%= home.description || 'No description provided.' %>
        </p>
      </div>
    </div>

  </div>

</div>

</div>
</body>

</html>