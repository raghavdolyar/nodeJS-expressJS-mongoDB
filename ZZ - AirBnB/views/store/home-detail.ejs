<%- include('../partials/head') %>

<div class="w-full max-w-5xl mx-auto px-4 sm:px-6 pb-20">

  <div class="mb-8">
    <a href="/homes" class="inline-flex items-center gap-2 text-gray-400 hover:text-gray-700 dark:hover:text-white text-sm font-medium transition-all duration-200">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="h-4 w-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
      </svg>
      Back to all homes
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 mb-10">

    <div class="lg:col-span-5">
      <div class="relative bg-gray-100 dark:bg-[#161618] border border-gray-200 dark:border-white/8 rounded-2xl overflow-hidden shadow-sm dark:shadow-lg">
        <% if (home.photo_url) { %>
          <img src="<%= home.photo_url %>" alt="<%= home.name %>" class="w-full aspect-4/3 object-cover" />
        <% } else { %>
          <div class="w-full aspect-4/3 flex flex-col items-center justify-center gap-3 bg-linear-to-br from-gray-100 to-gray-200 dark:from-[#1a1a1f] dark:to-[#111114]">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-14 h-14 text-gray-300 dark:text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.25">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
            </svg>
            <span class="text-xs font-medium text-gray-400 dark:text-gray-600 uppercase tracking-wider">No image available</span>
          </div>
        <% } %>
        <div class="absolute top-4 right-4 inline-flex items-center gap-1 bg-white/90 dark:bg-[#111114]/90 text-amber-500 text-sm font-semibold px-3 py-1.5 rounded-lg border border-gray-200 dark:border-white/10 backdrop-blur-sm shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
            <path fill-rule="evenodd" d="M10.788 3.21c.448-1.064 1.12-1.064 1.568 0l2.759 6.536 7.058.588c1.164.097 1.636 1.545.749 2.305l-5.365 4.749 1.634 6.873c.271 1.14-.946 2.033-1.92 1.433L12 18.98l-6.271 3.704c-.974.6-2.19-.294-1.92-1.433l1.634-6.873-5.365-4.749c-.887-.76-.415-2.208.749-2.305l7.058-.588 2.759-6.536z" clip-rule="evenodd" />
          </svg>
          <%= home.rating %>
        </div>
      </div>
    </div>

    <div class="lg:col-span-7 flex flex-col">
      <p class="text-[#D6001C] text-xs font-semibold uppercase tracking-widest mb-2">Home details</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-3 tracking-tight"><%= home.name %></h1>
      <p class="inline-flex items-center gap-2 text-gray-500 dark:text-gray-400 text-base mb-6">
        <svg class="w-4 h-4 text-[#D6001C] shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z" />
        </svg>
        <%= home.location %>
      </p>

      <hr class="border-gray-200 dark:border-white/8 mb-6" />

      <div class="mb-8">
        <p class="text-gray-400 dark:text-gray-500 text-xs font-medium uppercase tracking-wide mb-1">Price per night</p>
        <div class="flex items-baseline gap-2">
          <span class="text-4xl font-bold text-gray-900 dark:text-white">$<%= home.price_per_night %></span>
          <span class="text-gray-400 dark:text-gray-500 text-sm">/ night</span>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 mt-auto">
        <a href="/homes/<%= home._id %>/book" class="flex-1 inline-flex items-center justify-center gap-2 bg-[#22c55e] hover:bg-[#16a34a] text-white font-semibold py-3.5 rounded-xl transition-all duration-200 shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="h-5 w-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
          </svg>
          Book Now
        </a>
        <div class="flex-1">
          <%- include('../partials/favourite.ejs', { home }) %>
        </div>
      </div>
    </div>

  </div>

  <hr class="border-gray-200 dark:border-white/8 mb-10" />

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">

    <div class="md:col-span-1 flex flex-col gap-4">
      <div class="bg-white dark:bg-[#161618] border border-gray-200 dark:border-white/8 rounded-xl p-5 transition-colors hover:border-amber-300 dark:hover:border-amber-400/20">
        <p class="text-gray-400 dark:text-gray-500 text-xs font-medium uppercase tracking-wide mb-1">Guest rating</p>
        <p class="text-gray-900 dark:text-white text-xl font-bold"><%= home.rating %> <span class="text-amber-500">★</span></p>
      </div>
      <div class="bg-white dark:bg-[#161618] border border-gray-200 dark:border-white/8 rounded-xl p-5 transition-colors hover:border-[#3b82f6]/30 dark:hover:border-[#3b82f6]/20">
        <p class="text-gray-400 dark:text-gray-500 text-xs font-medium uppercase tracking-wide mb-1">Location</p>
        <p class="text-gray-900 dark:text-white font-semibold"><%= home.location %></p>
      </div>
      <div class="bg-white dark:bg-[#161618] border border-gray-200 dark:border-white/8 rounded-xl p-5 transition-colors hover:border-gray-300 dark:hover:border-white/15">
        <p class="text-gray-400 dark:text-gray-500 text-xs font-medium uppercase tracking-wide mb-1">Home ID</p>
        <p class="text-gray-600 dark:text-gray-400 font-medium text-sm break-all">#<%= home._id %></p>
      </div>
    </div>

    <div class="md:col-span-2">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-3">About this place</h2>
      <p class="text-gray-600 dark:text-gray-300 text-base leading-relaxed mb-6">
        <%= home.description || 'No description provided.' %>
      </p>

      <% if (isLoggedIn) { %>
      <a href="/rules" class="inline-flex items-center gap-2 text-sm font-medium text-[#3b82f6] hover:text-blue-600 dark:text-blue-600 dark:hover:text-blue-500 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="h-4 w-4 shrink-0">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        Download Home Rules
      </a>
      <% } else { %>
      <p class="text-sm text-gray-400 dark:text-gray-500">
        <a href="/login" class="text-[#D6001C] hover:underline font-medium">Log in</a> to download the home rules.
      </p>
      <% } %>
    </div>

  </div>

</div>

</div>
</body>

</html>