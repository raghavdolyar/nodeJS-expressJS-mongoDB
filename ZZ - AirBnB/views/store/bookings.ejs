<%- include('../partials/head') %>

<%- include('../partials/page-header', {
  eyebrow: 'Travel',
  titleHtml: 'Your <span class="text-[#D6001C]">bookings</span>',
  subtitle: 'All your upcoming and past stays in one place.'
}) %>

<main class="w-full max-w-4xl mx-auto px-4 sm:px-6 pb-20">

  <% if (!bookings || bookings.length === 0) { %>

  <%# ── Empty state ── %>
  <div class="flex flex-col items-center justify-center py-20 px-6 gap-5 text-center bg-gray-50/50 dark:bg-white/2 rounded-2xl border border-gray-100 dark:border-white/5">
    <div class="w-16 h-16 rounded-full bg-white dark:bg-[#1e1e20] shadow-sm flex items-center justify-center border border-gray-100 dark:border-white/10">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-[#D84E55]">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
      </svg>
    </div>

    <div class="max-w-md">
      <h3 class="text-gray-900 dark:text-white font-bold text-xl mb-1.5">No bookings yet</h3>
      <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed">It looks like you haven't planned your next adventure. Browse our handpicked homes and start packing your bags.</p>
    </div>

    <a href="/homes" class="inline-flex items-center justify-center px-6 py-2.5 bg-[#D6001C] hover:bg-[#D84E55] text-white text-sm font-semibold rounded-lg transition-colors shadow-sm mt-2">
      Start Exploring
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 ml-1.5">
        <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
      </svg>
    </a>
  </div>

  <% } else { %>

  <%# ── Booking list ── %>
  <div class="grid grid-cols-1 gap-5">
    <% bookings.forEach(booking => {
        const home      = booking.home_id;
        const checkIn   = new Date(booking.check_in);
        const checkOut  = new Date(booking.check_out);
        const nights    = Math.round((checkOut - checkIn) / (1000 * 60 * 60 * 24));

        const fmtDate = (d) => d.toLocaleDateString('en-US', { day: 'numeric', month: 'short' });

        const statusStyles = {
          pending:   { bg: 'bg-amber-100/90 dark:bg-amber-500/20', text: 'text-amber-800 dark:text-amber-300', border: 'border-amber-200/50 dark:border-amber-500/30' },
          confirmed: { bg: 'bg-emerald-100/90 dark:bg-emerald-500/20', text: 'text-emerald-800 dark:text-emerald-300', border: 'border-emerald-200/50 dark:border-emerald-500/30' },
          cancelled: { bg: 'bg-red-100/90 dark:bg-red-500/20', text: 'text-red-800 dark:text-red-300', border: 'border-red-200/50 dark:border-red-500/30' },
        };
        const statusLabel = booking.status.charAt(0).toUpperCase() + booking.status.slice(1);
        const style  = statusStyles[booking.status] || statusStyles.pending;
      %>

    <div class="group relative bg-white dark:bg-[#161618] rounded-2xl overflow-hidden flex flex-col md:flex-row shadow-sm hover:shadow-md border border-gray-100 dark:border-white/5 hover:border-gray-200 dark:hover:border-white/10 transition-colors">

      <%# Left Image Area %>
      <div class="relative w-full md:w-56 h-48 md:h-auto shrink-0 overflow-hidden">
        <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/10 to-transparent z-10"></div>
        <img src="<%= home.photo_url %>" alt="<%= home.name %>" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />



        <%# Price Overlay %>
        <div class="absolute bottom-3 left-3 z-20 flex flex-col">
          <span class="text-white/80 text-[9px] font-bold uppercase tracking-widest">Total Price</span>
          <div class="flex items-baseline gap-1">
            <span class="text-white font-bold text-xl">$<%= booking.total_price.toLocaleString() %></span>
          </div>
        </div>
      </div>

      <%# Right Content Area %>
      <div class="flex flex-col flex-1 p-5 md:p-6 justify-between gap-5">

        <div class="flex flex-col gap-4">
          <%# Header %>
          <%# Header %>
          <div class="flex justify-between items-start gap-4">
            <div>
              <h3 class="text-gray-900 dark:text-white font-bold text-lg md:text-xl leading-tight mb-1.5 group-hover:text-[#D84E55] transition-colors line-clamp-2">
                <%= home.name %>
              </h3>
              <div class="flex items-center gap-1.5 text-gray-500 dark:text-gray-400 text-sm font-medium">
                <svg class="w-3.5 h-3.5 text-[#D84E55]" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z" />
                </svg>
                <%= home.location %>
              </div>
            </div>

            <%# Status Badge %>
            <div class="shrink-0 flex items-center gap-1.5 px-2.5 py-1 rounded-full <%= style.bg %> <%= style.border %> border">
              <div class="w-1.5 h-1.5 shrink-0 rounded-full hidden <%= style.text.replace('text-', 'bg-') %>"></div>
              <span class="text-[10px] font-bold uppercase tracking-wider <%= style.text %>"><%= statusLabel %></span>
            </div>
          </div>

          <%# Dates Details %>
          <div class="grid grid-cols-3 gap-3 items-center p-3.5 rounded-xl bg-gray-50/50 dark:bg-white/2 border border-gray-100 dark:border-white/5">
            <div class="flex flex-col">
              <span class="text-[9px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-0.5">Check In</span>
              <span class="text-gray-900 dark:text-white font-semibold text-sm md:text-base"><%= fmtDate(checkIn) %></span>
            </div>

            <div class="flex flex-col items-center justify-center px-1">
              <div class="flex items-center gap-1.5 w-full">
                <div class="h-px flex-1 bg-gray-200 dark:bg-white/10"></div>
                <div class="px-2 py-0.5 rounded-md bg-[#D84E55]/10 text-[#D84E55] text-[10px] font-bold uppercase tracking-wider whitespace-nowrap">
                  <%= nights %> night<%= nights !== 1 ? 's' : '' %>
                </div>
                <div class="h-px flex-1 bg-gray-200 dark:bg-white/10"></div>
              </div>
            </div>

            <div class="flex flex-col text-right">
              <span class="text-[9px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-0.5">Check Out</span>
              <span class="text-gray-900 dark:text-white font-semibold text-sm md:text-base"><%= fmtDate(checkOut) %></span>
            </div>
          </div>
        </div>

        <%# Actions %>
        <div class="flex flex-col sm:flex-row items-center gap-2.5 md:justify-end pt-3 border-t border-gray-100 dark:border-white/5">
          <form action="/bookings/delete/<%= booking._id %>" method="POST" class="m-0 w-full sm:w-auto">
            <button type="submit" class="w-full sm:w-auto px-4 py-2 bg-white dark:bg-transparent border border-gray-200 dark:border-white/10 text-gray-700 dark:text-gray-300 hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-500/10 hover:border-red-200 dark:hover:border-red-500/30 text-xs font-semibold rounded-lg transition-colors">
              Cancel Booking
            </button>
          </form>
          <a href="/homes/<%= home._id %>" class="w-full sm:w-auto inline-flex justify-center items-center px-4 py-2 bg-[#D6001C] hover:bg-[#D84E55] text-white text-xs font-semibold rounded-lg transition-colors shadow-sm">
            View Home
          </a>
        </div>

      </div>
    </div>

    <% }) %>
  </div>

  <% } %>

</main>

</div>
</body>

</html>