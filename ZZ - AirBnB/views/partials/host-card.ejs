<div class="bg-white dark:bg-[#161618] border border-gray-200 dark:border-white/8 rounded-xl overflow-hidden w-full max-w-xs sm:max-w-none transition-all duration-200 group hover:shadow-md dark:hover:shadow-black/30 hover:border-gray-300 dark:hover:border-white/15">

  <div class="relative overflow-hidden">
    <% if (home.photo_url) { %>
      <img src="<%= home.photo_url %>" alt="<%= home.name %>" class="w-full h-44 object-cover transition-transform duration-300 group-hover:scale-105" />
    <% } else { %>
      <div class="w-full h-44 flex flex-col items-center justify-center gap-2 bg-linear-to-br from-gray-100 to-gray-200 dark:from-[#1a1a1f] dark:to-[#111114]">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-gray-300 dark:text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.25">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
        </svg>
        <span class="text-[11px] font-medium text-gray-400 dark:text-gray-600 uppercase tracking-wider">No image available</span>
      </div>
    <% } %>

    <div class="absolute top-2.5 right-2.5 flex gap-1.5 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
      <a href="/host/edit-home/<%= home._id %>?editing=true" class="p-1.5 rounded-lg bg-white/90 dark:bg-black/60 hover:bg-white dark:hover:bg-white/20 text-gray-700 dark:text-white backdrop-blur-sm transition-colors shadow-sm" title="Edit">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
        </svg>
      </a>
      <form action="/host/delete-home/<%= home._id %>" method="POST">
        <button class="p-1.5 rounded-lg bg-white/90 dark:bg-black/60 hover:bg-red-50 dark:hover:bg-red-500/20 text-gray-700 dark:text-white hover:text-red-600 dark:hover:text-red-400 backdrop-blur-sm transition-colors shadow-sm" title="Delete">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6" />
            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
            <path d="M10 11v6M14 11v6" />
            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
          </svg>
        </button>
      </form>
    </div>

    <span class="absolute bottom-2.5 left-3 text-[10px] font-semibold tracking-wide uppercase bg-[#D6001C]/90 text-white backdrop-blur-sm px-2 py-0.5 rounded-full">
      Your listing
    </span>
  </div>

  <div class="p-4 flex flex-col gap-3">

    <div class="flex items-start justify-between gap-2">
      <h3 class="text-gray-900 dark:text-white text-[17px] font-semibold leading-snug">
        <%= home.name %>
      </h3>
      <span class="flex items-center gap-1 text-[13px] text-amber-500 shrink-0 mt-0.5">
        ★ <%= home.rating %>
      </span>
    </div>

    <div class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500 text-[12px]">
      <svg class="w-3.5 h-3.5 text-[#D6001C] shrink-0" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z" />
      </svg>
      <%= home.location %>
    </div>

    <div class="border-t border-gray-100 dark:border-white/5 pt-3 flex items-center justify-between">
      <span class="text-gray-900 dark:text-white text-sm font-semibold">
        $<%= home.price_per_night %> <span class="text-gray-400 dark:text-gray-500 text-xs font-normal">/ night</span>
      </span>
      <span class="text-[11px] text-gray-400 dark:text-gray-600 italic">Hover to manage</span>
    </div>

  </div>
</div>