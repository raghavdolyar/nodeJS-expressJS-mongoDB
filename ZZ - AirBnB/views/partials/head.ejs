<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/output.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }

    * {
      -webkit-font-smoothing: antialiased;
    }
  </style>
  <script>
    // apply saved theme before paint to avoid flash
    (() => {
      const saved = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (saved === 'dark' || (!saved && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    })();

    // re-apply theme when page is restored from bfcache (back/forward navigation)
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const shouldBeDark = saved === 'dark' || (!saved && prefersDark);

        // freeze all transitions so the theme swap is instant (no visible flash)
        const noTransition = document.createElement('style');
        noTransition.textContent = '*,*::before,*::after{transition:none!important}';
        document.head.appendChild(noTransition);

        if (shouldBeDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }

        // double rAF: let the browser commit one paint with the new class,
        // then remove the override so normal transitions resume cleanly
        requestAnimationFrame(() => requestAnimationFrame(() => {
          document.head.removeChild(noTransition);
        }));
      }
    });
  </script>
</head>

<body class="bg-gray-50 dark:bg-[#0f0f11] min-h-screen flex flex-col items-center transition-colors duration-200">
  <%- include('./navbar', { currentPage }) %>
  <div class="w-full flex-1 flex flex-col items-center pt-8 pb-4 px-3 sm:px-4">

    <!-- Floating Dark Mode Toggle -->
    <button id="theme-toggle" onclick="(function(){const h=document.documentElement;const isDark=h.classList.toggle('dark');localStorage.setItem('theme',isDark?'dark':'light');})()" class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-11 h-11 rounded-full
           bg-white dark:bg-[#1e1e23] border border-gray-200 dark:border-white/10
           shadow-md hover:shadow-lg transition-all duration-200 hover:scale-105" title="Toggle dark mode" aria-label="Toggle dark mode">
      <!-- Sun icon (shown in dark mode) -->
      <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="hidden dark:block h-5 w-5 text-gray-200">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
      </svg>
      <!-- Moon icon (shown in light mode) -->
      <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="block dark:hidden h-5 w-5 text-gray-600">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
      </svg>
    </button>