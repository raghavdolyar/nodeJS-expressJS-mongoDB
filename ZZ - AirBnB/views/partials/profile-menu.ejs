<!-- Profile Dropdown Menu (Hidden by default) -->
<div id="profile-dropdown" class="absolute right-0 top-full mt-2 w-57 rounded-xl bg-white dark:bg-[#1e1e23] border border-gray-100 dark:border-white/10 shadow-xl dark:shadow-black/40 overflow-hidden transform opacity-0 scale-95 pointer-events-none transition-all duration-200 z-50 origin-top-right">

  <!-- User Info Section -->
  <div class="px-4 py-4 border-b border-gray-100 dark:border-white/10 flex items-center gap-3">
    <div class="w-12 h-12 rounded-full flex shrink-0 items-center justify-center font-bold text-lg tracking-tight <%= avatarColor %>">
      <%= initials %>
    </div>
    <div class="flex flex-col min-w-0">
      <span class="text-sm font-bold text-gray-900 dark:text-white truncate">
        <%= fullName.trim() || 'User' %>
      </span>
      <span class="text-xs text-gray-500 dark:text-gray-400 capitalize font-medium mt-0.5">
        <%= user.user_type %> Account
      </span>
    </div>
  </div>

  <!-- Menu Actions -->
  <div class="p-1.5">
    <a href="/profile/edit" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-100 dark:hover:bg-white/5 transition-colors duration-150">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-4 h-4 text-gray-400 dark:text-gray-500">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
      </svg>
      Edit Profile
    </a>

    <div class="h-px bg-gray-100 dark:bg-white/10 my-1.5 mx-2"></div>

    <a href="/profile/delete" class="w-full flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-red-600 dark:text-red-400 rounded-lg hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors duration-150 text-left">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
      </svg>
      Delete Account
    </a>
  </div>
</div>