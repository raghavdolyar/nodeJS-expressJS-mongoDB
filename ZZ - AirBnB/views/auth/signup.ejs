<%- include('../partials/head') %>

<%
  const errors = validationErrors || [];
  const fieldError = (path) => errors.find(err => err.path === path)?.msg;
  const input = oldInput || {};
  const inputClass = (path) =>
    'bg-gray-50 dark:bg-[#111114] text-gray-900 dark:text-white text-sm px-4 py-2.5 rounded-lg border focus:outline-none focus:border-[#D6001C] focus:ring-1 focus:ring-[#D6001C]/20 transition-colors placeholder-gray-400 dark:placeholder-gray-600 ' +
    (fieldError(path) ? 'border-red-400 dark:border-red-500/70' : 'border-gray-200 dark:border-[#2a2a2f]');
%>

<div class="w-full max-w-md mb-12">
  <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-2 text-center">
    Join <span class="text-[#D6001C]">AirBnB</span>
  </h2>
  <p class="text-gray-400 dark:text-gray-500 text-sm text-center mb-8">Create your account and start exploring</p>

  <%- include('../partials/validation-errors') %>

  <form action="/signup" method="POST" class="bg-white dark:bg-[#1a1a1f] rounded-2xl p-8 flex flex-col gap-5 shadow-sm dark:shadow-xl border border-gray-100 dark:border-white/6">

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <%- include('../partials/form-field', {
        id: 'firstName',
        name: 'firstName',
        label: 'First Name',
        placeholder: 'John',
        value: input.firstName || '',
        inputClass: inputClass('firstName'),
        errorMsg: fieldError('firstName'),
        autocomplete: 'given-name',
        required: true
      }) %>
      <%- include('../partials/form-field', {
        id: 'lastName',
        name: 'lastName',
        label: 'Last Name',
        placeholder: 'Doe',
        value: input.lastName || '',
        inputClass: inputClass('lastName'),
        errorMsg: fieldError('lastName'),
        autocomplete: 'family-name'
      }) %>
    </div>

    <%- include('../partials/form-field', {
      id: 'email',
      name: 'email',
      label: 'Email',
      type: 'email',
      placeholder: 'you@example.com',
      value: input.email || '',
      inputClass: inputClass('email'),
      errorMsg: fieldError('email'),
      autocomplete: 'email',
      required: true
    }) %>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <%- include('../partials/form-field', {
        id: 'password',
        name: 'password',
        label: 'Password',
        type: 'password',
        placeholder: '••••••••',
        inputClass: inputClass('password'),
        errorMsg: fieldError('password'),
        hint: fieldError('password') ? '' : 'Min 8 chars, with uppercase, lowercase, and a special character.',
        autocomplete: 'new-password',
        required: true
      }) %>
      <%- include('../partials/form-field', {
        id: 'confirmPassword',
        name: 'confirmPassword',
        label: 'Confirm Password',
        type: 'password',
        placeholder: '••••••••',
        inputClass: inputClass('confirmPassword'),
        errorMsg: fieldError('confirmPassword'),
        autocomplete: 'new-password',
        required: true
      }) %>
    </div>

    <div class="flex flex-col gap-2">
      <span class="text-sm text-gray-600 dark:text-gray-400 font-medium">I want to join as</span>
      <div class="grid grid-cols-2 gap-3">
        <label class="relative cursor-pointer group">
          <input type="radio" name="userType" value="guest" class="peer sr-only" <%= (!input.userType || input.userType === 'guest') ? 'checked' : '' %> required />
          <div class="flex flex-col items-center gap-2 p-4 rounded-xl border-2
            border-gray-200 dark:border-[#2a2a2f]
            bg-gray-50 dark:bg-[#111114]
            transition-all
            peer-checked:border-[#D6001C] peer-checked:bg-red-50 dark:peer-checked:bg-[#D6001C]/10
            group-hover:border-[#D6001C]/40">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 text-gray-500 dark:text-gray-400 peer-checked:text-[#D6001C] group-[.peer:checked~div]:text-[#D6001C]">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
            <span class="text-sm font-semibold text-gray-900 dark:text-white">Guest</span>
            <span class="text-xs text-gray-400 dark:text-gray-500 text-center">Book & explore stays</span>
          </div>
        </label>
        <label class="relative cursor-pointer group">
          <input type="radio" name="userType" value="host" class="peer sr-only" <%= input.userType === 'host' ? 'checked' : '' %> />
          <div class="flex flex-col items-center gap-2 p-4 rounded-xl border-2
            border-gray-200 dark:border-[#2a2a2f]
            bg-gray-50 dark:bg-[#111114]
            transition-all
            peer-checked:border-[#D6001C] peer-checked:bg-red-50 dark:peer-checked:bg-[#D6001C]/10
            group-hover:border-[#D6001C]/40">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 text-gray-500 dark:text-gray-400">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
            </svg>
            <span class="text-sm font-semibold text-gray-900 dark:text-white">Host</span>
            <span class="text-xs text-gray-400 dark:text-gray-500 text-center">List & manage homes</span>
          </div>
        </label>
      </div>
      <% if (fieldError('userType')) { %>
      <p class="text-xs text-red-500 dark:text-red-400"><%= fieldError('userType') %></p>
      <% } %>
    </div>

    <%# phone number — only visible when Host is selected %>
    <div id="phoneField" class="flex flex-col gap-1.5" style="display: none;">
      <%- include('../partials/form-field', {
        id: 'phone',
        name: 'phone',
        label: 'Phone Number',
        type: 'tel',
        placeholder: '+91 98765 43210',
        value: input.phone || '',
        inputClass: inputClass('phone'),
        errorMsg: fieldError('phone'),
        hint: fieldError('phone') ? '' : 'Guests may contact you through this number.',
        autocomplete: 'tel'
      }) %>
    </div>

    <script>
      (function() {
        const phoneField = document.getElementById('phoneField');
        const phoneInput = document.getElementById('phone');
        const radios = document.querySelectorAll('input[name="userType"]');

        function togglePhone() {
          const isHost = document.querySelector('input[name="userType"]:checked')?.value === 'host';
          phoneField.style.display = isHost ? '' : 'none';
          phoneInput.required = isHost;
        }

        radios.forEach(r => r.addEventListener('change', togglePhone));

        // on page load — restore state if "host" was previously selected (e.g. after validation error)
        togglePhone();
      })();
    </script>

    <div class="flex flex-col gap-1.5">
      <label class="flex items-start gap-3 cursor-pointer group">
        <input type="checkbox" name="terms" value="accepted" class="mt-1 w-4 h-4 rounded border-gray-300 dark:border-[#2a2a2f] bg-white dark:bg-[#111114] accent-[#D6001C] cursor-pointer" required />
        <span class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed group-hover:text-gray-700 dark:group-hover:text-gray-300 transition-colors">
          I agree to the
          <a href="#" class="text-[#3b82f6] hover:text-blue-500 underline underline-offset-2">Terms & Conditions</a>
          and
          <a href="#" class="text-[#3b82f6] hover:text-blue-500 underline underline-offset-2">Privacy Policy</a>
        </span>
      </label>
      <% if (fieldError('terms')) { %>
      <p class="text-xs text-red-500 dark:text-red-400"><%= fieldError('terms') %></p>
      <% } %>
    </div>

    <button type="submit" class="mt-1 bg-[#D6001C] hover:bg-[#b8001a] active:scale-[0.98] text-white text-sm font-semibold py-3 rounded-lg transition-all shadow-sm">
      Create Account
    </button>

    <p class="text-center text-sm text-gray-400 dark:text-gray-500">
      Already have an account?
      <a href="/login" class="text-[#3b82f6] hover:text-blue-500 font-medium transition-colors">Log in</a>
    </p>

  </form>
</div>

</div>
</body>

</html>