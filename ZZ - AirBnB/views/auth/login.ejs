<%- include('../partials/head') %>

<%
  const errors = validationErrors || [];
  const fieldError = (path) => errors.find(err => err.path === path)?.msg;
  const input = oldInput || {};
  const inputClass = (path) =>
    'bg-gray-50 dark:bg-[#111114] text-gray-900 dark:text-white text-sm px-4 py-2.5 rounded-lg border focus:outline-none focus:border-[#D6001C] focus:ring-1 focus:ring-[#D6001C]/20 transition-colors placeholder-gray-400 dark:placeholder-gray-600 ' +
    (fieldError(path) ? 'border-red-400 dark:border-red-500/70' : 'border-gray-200 dark:border-[#2a2a2f]');
%>

<div class="w-full max-w-sm">
  <div class="flex justify-center mb-6">
    <span class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-[#D6001C]/10 dark:bg-[#D6001C]/20">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6 text-[#D6001C]">
        <path d="M11.47 3.84a.75.75 0 011.06 0l8.69 8.69a.75.75 0 101.06-1.06l-8.689-8.69a2.25 2.25 0 00-3.182 0l-8.69 8.69a.75.75 0 001.061 1.06l8.69-8.69z" />
        <path d="M12 5.432l8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 01-.75-.75v-4.5a.75.75 0 00-.75-.75h-3a.75.75 0 00-.75.75V21a.75.75 0 01-.75.75H5.625a1.875 1.875 0 01-1.875-1.875v-6.198a2.29 2.29 0 00.091-.086L12 5.43z" />
      </svg>
    </span>
  </div>
  <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-1 text-center">Welcome Back</h2>
  <p class="text-gray-400 dark:text-gray-500 text-sm text-center mb-6">Sign in to your account</p>

  <%- include('../partials/validation-errors') %>

  <form action="/login" method="POST" class="bg-white dark:bg-[#1a1a1f] rounded-2xl p-8 flex flex-col gap-4 shadow-sm dark:shadow-lg border border-gray-100 dark:border-white/6">

    <!-- Login type selector -->
    <div class="flex flex-col gap-1.5">
      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">I am a</label>
      <div id="login-type-toggle" class="grid grid-cols-2 gap-2">

        <label id="label-guest" class="login-type-option flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg border cursor-pointer text-sm font-medium transition-all duration-150 bg-gray-50
          <%= (input.loginType === 'host') ? 'border-gray-200 dark:border-[#2a2a2f] text-gray-500 dark:text-gray-400 dark:bg-[#111114]' : 'border-[#D6001C] dark:bg-[#D6001C]/15 text-[#D6001C]' %>">
          <input type="radio" name="loginType" value="guest" class="sr-only" <%= (input.loginType !== 'host') ? 'checked' : '' %>>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="h-4 w-4 shrink-0">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
          </svg>
          Guest
        </label>

        <label id="label-host" class="login-type-option flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg border cursor-pointer text-sm font-medium transition-all duration-150 bg-gray-50
          <%= (input.loginType === 'host') ? 'border-[#D6001C] dark:bg-[#D6001C]/15 text-[#D6001C]' : 'border-gray-200 dark:border-[#2a2a2f] text-gray-500 dark:text-gray-400 dark:bg-[#111114]' %>">
          <input type="radio" name="loginType" value="host" class="sr-only" <%= (input.loginType === 'host') ? 'checked' : '' %>>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="h-4 w-4 shrink-0">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 21v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21m0 0h4.5V3.545M12.75 21h7.5V10.75M2.25 21h1.5m18 0h-18M2.25 9l4.5-1.636M18.75 3l-1.5.545m0 6.205 3 1m1.5.5-1.5-.5M6.75 7.364V3h-3v18m3-13.636 10.5-3.819" />
          </svg>
          Host
        </label>

      </div>
      <% if (fieldError('loginType')) { %>
      <p class="text-xs text-red-500 mt-0.5"><%= fieldError('loginType') %></p>
      <% } %>
    </div>

    <%- include('../partials/form-field', {
      id: 'email',
      name: 'email',
      label: 'Email',
      type: 'email',
      placeholder: 'you@example.com',
      value: input.email || '',
      inputClass: inputClass('email'),
      errorMsg: fieldError('email'),
      autocomplete: 'email',
      required: true
    }) %>

    <%- include('../partials/form-field', {
      id: 'password',
      name: 'password',
      label: 'Password',
      type: 'password',
      placeholder: '••••••••',
      inputClass: inputClass('password'),
      errorMsg: fieldError('password'),
      autocomplete: 'current-password',
      required: true
    }) %>

    <button type="submit" class="mt-2 bg-[#D6001C] hover:bg-[#b8001a] active:scale-[0.98] text-white text-sm font-semibold py-2.5 rounded-lg transition-all shadow-sm">
      Log In
    </button>

    <p class="text-center text-sm text-gray-400 dark:text-gray-500">
      Don't have an account?
      <a href="/signup" class="text-[#3b82f6] hover:text-blue-500 font-medium transition-colors">Sign up</a>
    </p>

  </form>
</div>

<script>
  // Visually update the toggle labels when a radio changes
  document.querySelectorAll('input[name="loginType"]').forEach(radio => {
    radio.addEventListener('change', () => {
      document.querySelectorAll('.login-type-option').forEach(label => {
        const isSelected = label.querySelector('input').checked;
        if (isSelected) {
          label.classList.add('border-[#D6001C]', 'bg-[#D6001C]/8', 'dark:bg-[#D6001C]/15', 'text-[#D6001C]');
          label.classList.remove('border-gray-200', 'dark:border-[#2a2a2f]', 'text-gray-500', 'dark:text-gray-400', 'bg-gray-50', 'dark:bg-[#111114]');
        } else {
          label.classList.add('border-gray-200', 'dark:border-[#2a2a2f]', 'text-gray-500', 'dark:text-gray-400', 'bg-gray-50', 'dark:bg-[#111114]');
          label.classList.remove('border-[#D6001C]', 'bg-[#D6001C]/8', 'dark:bg-[#D6001C]/15', 'text-[#D6001C]');
        }
      });
    });
  });
</script>

</div>
</body>

</html>