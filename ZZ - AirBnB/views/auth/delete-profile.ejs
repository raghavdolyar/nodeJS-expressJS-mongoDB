<%- include('../partials/head') %>

<div class="w-[25vw] min-w-[320px] max-w-md my-auto flex flex-col items-center">
  <div class="w-16 h-16 rounded-full bg-red-100 dark:bg-red-500/20 flex items-center justify-center mb-6 shadow-sm">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-red-600 dark:text-red-500">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
  </div>
  
  <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-3 text-center">
    Delete Account
  </h2>
  <p class="text-gray-500 dark:text-gray-400 text-sm text-center mb-8 px-4 leading-relaxed">
    Are you sure you want to delete your account? This action is <span class="font-semibold text-gray-700 dark:text-gray-300">permanent</span> and cannot be undone. All your data, bookings, and preferences will be erased.
  </p>

  <div class="bg-white dark:bg-[#1a1a1f] w-[85%] rounded-2xl p-6 shadow-sm dark:shadow-xl border border-gray-100 dark:border-white/6">
    <form action="/profile/delete" method="POST" class="flex flex-col gap-4">
      <button type="submit" class="w-full bg-[#D6001C] hover:bg-[#b8001a] active:scale-[0.98] text-white text-sm font-semibold py-3 rounded-lg transition-all shadow-sm">
        Yes, Delete My Account
      </button>
      <a href="/" class="w-full text-center bg-gray-100 dark:bg-[#2a2a2f] hover:bg-gray-200 dark:hover:bg-white/10 active:scale-[0.98] text-gray-700 dark:text-gray-200 text-sm font-semibold py-3 rounded-lg transition-all">
        Cancel, Keep My Account
      </a>
    </form>
  </div>
</div>

</div>
</body>
</html>
