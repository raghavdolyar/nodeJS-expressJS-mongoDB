<%- include('./partials/head') %>

<div class="flex flex-col items-center justify-center text-center px-4 py-16 min-h-[70vh]">

  <div class="mb-6 flex items-center justify-center w-24 h-24 rounded-full bg-rose-50 dark:bg-rose-900/20 border border-rose-100 dark:border-rose-800/30">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 text-[#D6001C]">
      <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
    </svg>
  </div>

  <p class="text-sm font-semibold tracking-widest text-[#D6001C] uppercase mb-2">Error 403</p>

  <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-3">
    <%= title %>
  </h1>

  <p class="text-gray-500 dark:text-gray-400 text-sm sm:text-base max-w-sm mb-10 leading-relaxed">
    <%= message %>
  </p>

  <div class="flex flex-col sm:flex-row gap-3">
    <% if (showLogin) { %>
    <a href="/login" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-[#D6001C] text-white text-sm font-semibold hover:bg-red-700 transition-all duration-200 shadow-sm hover:shadow-md">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75" />
      </svg>
      Log In
    </a>
    <% } %>

    <% if (showSignup) { %>
    <a href="/signup" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-white dark:bg-[#1e1e23] text-gray-800 dark:text-white text-sm font-semibold border border-gray-200 dark:border-white/10 hover:border-gray-300 dark:hover:border-white/20 transition-all duration-200 shadow-sm hover:shadow-md">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM4 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 10.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
      </svg>
      Create Account
    </a>
    <% } %>

    <a href="/" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-white dark:bg-[#1e1e23] text-gray-800 dark:text-white text-sm font-semibold border border-gray-200 dark:border-white/10 hover:border-gray-300 dark:hover:border-white/20 transition-all duration-200 shadow-sm hover:shadow-md">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
      </svg>
      Go Home
    </a>
  </div>

</div>

</div>
</body>

</html>