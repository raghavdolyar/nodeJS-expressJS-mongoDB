<%- include('../partials/head') %>

<%
  const errors = validationErrors || [];
  const fieldError = (path) => errors.find(err => err.path === path)?.msg;
  const input = oldInput || {};
  const inputClass = (path) =>
    'bg-[#111114] text-white text-sm px-4 py-2.5 rounded-lg border focus:outline-none focus:border-[#e51414] focus:ring-1 focus:ring-[#e51414]/30 transition-colors placeholder-gray-600 ' +
    (fieldError(path) ? 'border-[#e51414]/70' : 'border-[#2a2a2f]');
%>

<div class="w-full max-w-md mb-12">
  <h2 class="text-3xl font-bold text-white mb-2 text-center">
    Join <span class="text-[#e51414]">AirB<span class="text-white">n</span>B</span>
  </h2>
  <p class="text-gray-500 text-sm text-center mb-8">Create your account and start exploring</p>

  <%- include('../partials/validation-errors') %>

  <form action="/signup" method="POST" class="bg-[#1a1a1f] rounded-2xl p-8 flex flex-col gap-5 shadow-xl border border-[#2a2a2f]/50">

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <%- include('../partials/form-field', {
        id: 'firstName',
        name: 'firstName',
        label: 'First Name',
        placeholder: 'John',
        value: input.firstName || '',
        inputClass: inputClass('firstName'),
        errorMsg: fieldError('firstName'),
        autocomplete: 'given-name',
        required: true
      }) %>
      <%- include('../partials/form-field', {
        id: 'lastName',
        name: 'lastName',
        label: 'Last Name',
        placeholder: 'Doe',
        value: input.lastName || '',
        inputClass: inputClass('lastName'),
        errorMsg: fieldError('lastName'),
        autocomplete: 'family-name'
      }) %>
    </div>

    <%- include('../partials/form-field', {
      id: 'email',
      name: 'email',
      label: 'Email',
      type: 'email',
      placeholder: 'you@example.com',
      value: input.email || '',
      inputClass: inputClass('email'),
      errorMsg: fieldError('email'),
      autocomplete: 'email',
      required: true
    }) %>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <%- include('../partials/form-field', {
        id: 'password',
        name: 'password',
        label: 'Password',
        type: 'password',
        placeholder: '••••••••',
        inputClass: inputClass('password'),
        errorMsg: fieldError('password'),
        hint: fieldError('password') ? '' : 'Min 8 chars, with uppercase, lowercase, and a special character.',
        autocomplete: 'new-password',
        required: true
      }) %>
      <%- include('../partials/form-field', {
        id: 'confirmPassword',
        name: 'confirmPassword',
        label: 'Confirm Password',
        type: 'password',
        placeholder: '••••••••',
        inputClass: inputClass('confirmPassword'),
        errorMsg: fieldError('confirmPassword'),
        autocomplete: 'new-password',
        required: true
      }) %>
    </div>

    <div class="flex flex-col gap-2">
      <span class="text-sm text-gray-400 font-medium">I want to join as</span>
      <div class="grid grid-cols-2 gap-3">
        <label class="relative cursor-pointer group">
          <input type="radio" name="userType" value="guest" class="peer sr-only"
            <%= (!input.userType || input.userType === 'guest') ? 'checked' : '' %> required />
          <div class="flex flex-col items-center gap-2 p-4 rounded-xl border-2 border-[#2a2a2f] bg-[#111114] transition-all peer-checked:border-[#e51414] peer-checked:bg-[#e51414]/10 group-hover:border-[#e51414]/50">
            <span class="text-2xl" aria-hidden="true">🏠</span>
            <span class="text-sm font-semibold text-white">Guest</span>
            <span class="text-xs text-gray-500 text-center">Book & explore stays</span>
          </div>
        </label>
        <label class="relative cursor-pointer group">
          <input type="radio" name="userType" value="host" class="peer sr-only"
            <%= input.userType === 'host' ? 'checked' : '' %> />
          <div class="flex flex-col items-center gap-2 p-4 rounded-xl border-2 border-[#2a2a2f] bg-[#111114] transition-all peer-checked:border-[#e51414] peer-checked:bg-[#e51414]/10 group-hover:border-[#e51414]/50">
            <span class="text-2xl" aria-hidden="true">🔑</span>
            <span class="text-sm font-semibold text-white">Host</span>
            <span class="text-xs text-gray-500 text-center">List & manage homes</span>
          </div>
        </label>
      </div>
      <% if (fieldError('userType')) { %>
        <p class="text-xs text-[#ff8a8a]"><%= fieldError('userType') %></p>
      <% } %>
    </div>

    <div class="flex flex-col gap-1.5">
      <label class="flex items-start gap-3 cursor-pointer group">
        <input type="checkbox" name="terms" value="accepted"
          class="mt-1 w-4 h-4 rounded border-[#2a2a2f] bg-[#111114] text-[#e51414] focus:ring-[#e51414] focus:ring-offset-0 focus:ring-offset-[#1a1a1f] accent-[#e51414] cursor-pointer"
          required />
        <span class="text-sm text-gray-400 leading-relaxed group-hover:text-gray-300 transition-colors">
          I agree to the
          <a href="#" class="text-[#e51414] hover:text-[#ff2a2a] underline underline-offset-2">Terms & Conditions</a>
          and
          <a href="#" class="text-[#e51414] hover:text-[#ff2a2a] underline underline-offset-2">Privacy Policy</a>
        </span>
      </label>
      <% if (fieldError('terms')) { %>
        <p class="text-xs text-[#ff8a8a]"><%= fieldError('terms') %></p>
      <% } %>
    </div>

    <button type="submit"
      class="mt-1 bg-[#e51414] hover:bg-[#c10d0d] active:scale-[0.98] text-white text-sm font-semibold py-3 rounded-lg transition-all shadow-lg shadow-[#e51414]/20">
      Create Account
    </button>

    <p class="text-center text-sm text-gray-500">
      Already have an account?
      <a href="/login" class="text-[#e51414] hover:text-[#ff2a2a] font-medium transition-colors">Log in</a>
    </p>

  </form>
</div>

</div>
</body>

</html>
