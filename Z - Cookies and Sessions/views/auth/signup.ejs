<%- include('../partials/head') %>

<div class="w-full max-w-md mb-12">
  <h2 class="text-3xl font-bold text-white mb-2 text-center">
    Join <span class="text-[#e51414]">AirB<span class="text-white">n</span>B</span>
  </h2>
  <p class="text-gray-500 text-sm text-center mb-8">Create your account and start exploring</p>

  <form action="/signup" method="POST" class="bg-[#1a1a1f] rounded-2xl p-8 flex flex-col gap-5 shadow-xl border border-[#2a2a2f]/50">

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="flex flex-col gap-1.5">
        <label for="firstName" class="text-sm text-gray-400 font-medium">First Name</label>
        <input type="text" id="firstName" name="firstName" placeholder="John"
          class="bg-[#111114] text-white text-sm px-4 py-2.5 rounded-lg border border-[#2a2a2f] focus:outline-none focus:border-[#e51414] focus:ring-1 focus:ring-[#e51414]/30 transition-colors placeholder-gray-600"
          autocomplete="given-name" required />
      </div>
      <div class="flex flex-col gap-1.5">
        <label for="lastName" class="text-sm text-gray-400 font-medium">Last Name</label>
        <input type="text" id="lastName" name="lastName" placeholder="Doe"
          class="bg-[#111114] text-white text-sm px-4 py-2.5 rounded-lg border border-[#2a2a2f] focus:outline-none focus:border-[#e51414] focus:ring-1 focus:ring-[#e51414]/30 transition-colors placeholder-gray-600"
          autocomplete="family-name" />
      </div>
    </div>

    <div class="flex flex-col gap-1.5">
      <label for="email" class="text-sm text-gray-400 font-medium">Email</label>
      <input type="email" id="email" name="email" placeholder="you@example.com"
        class="bg-[#111114] text-white text-sm px-4 py-2.5 rounded-lg border border-[#2a2a2f] focus:outline-none focus:border-[#e51414] focus:ring-1 focus:ring-[#e51414]/30 transition-colors placeholder-gray-600"
        autocomplete="email" required />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="flex flex-col gap-1.5">
        <label for="password" class="text-sm text-gray-400 font-medium">Password</label>
        <input type="password" id="password" name="password" placeholder="••••••••"
          class="bg-[#111114] text-white text-sm px-4 py-2.5 rounded-lg border border-[#2a2a2f] focus:outline-none focus:border-[#e51414] focus:ring-1 focus:ring-[#e51414]/30 transition-colors placeholder-gray-600"
          autocomplete="new-password" required />
      </div>
      <div class="flex flex-col gap-1.5">
        <label for="confirmPassword" class="text-sm text-gray-400 font-medium">Confirm Password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••"
          class="bg-[#111114] text-white text-sm px-4 py-2.5 rounded-lg border border-[#2a2a2f] focus:outline-none focus:border-[#e51414] focus:ring-1 focus:ring-[#e51414]/30 transition-colors placeholder-gray-600"
          autocomplete="new-password" required />
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <span class="text-sm text-gray-400 font-medium">I want to join as</span>
      <div class="grid grid-cols-2 gap-3">
        <label class="relative cursor-pointer group">
          <input type="radio" name="userType" value="guest" class="peer sr-only" checked required />
          <div class="flex flex-col items-center gap-2 p-4 rounded-xl border-2 border-[#2a2a2f] bg-[#111114] transition-all peer-checked:border-[#e51414] peer-checked:bg-[#e51414]/10 group-hover:border-[#e51414]/50">
            <span class="text-2xl" aria-hidden="true">🏠</span>
            <span class="text-sm font-semibold text-white">Guest</span>
            <span class="text-xs text-gray-500 text-center">Book & explore stays</span>
          </div>
        </label>
        <label class="relative cursor-pointer group">
          <input type="radio" name="userType" value="host" class="peer sr-only" />
          <div class="flex flex-col items-center gap-2 p-4 rounded-xl border-2 border-[#2a2a2f] bg-[#111114] transition-all peer-checked:border-[#e51414] peer-checked:bg-[#e51414]/10 group-hover:border-[#e51414]/50">
            <span class="text-2xl" aria-hidden="true">🔑</span>
            <span class="text-sm font-semibold text-white">Host</span>
            <span class="text-xs text-gray-500 text-center">List & manage homes</span>
          </div>
        </label>
      </div>
    </div>

    <label class="flex items-start gap-3 cursor-pointer group">
      <input type="checkbox" name="terms" value="accepted"
        class="mt-1 w-4 h-4 rounded border-[#2a2a2f] bg-[#111114] text-[#e51414] focus:ring-[#e51414] focus:ring-offset-0 focus:ring-offset-[#1a1a1f] accent-[#e51414] cursor-pointer"
        required />
      <span class="text-sm text-gray-400 leading-relaxed group-hover:text-gray-300 transition-colors">
        I agree to the
        <a href="#" class="text-[#e51414] hover:text-[#ff2a2a] underline underline-offset-2">Terms & Conditions</a>
        and
        <a href="#" class="text-[#e51414] hover:text-[#ff2a2a] underline underline-offset-2">Privacy Policy</a>
      </span>
    </label>

    <button type="submit"
      class="mt-1 bg-[#e51414] hover:bg-[#c10d0d] active:scale-[0.98] text-white text-sm font-semibold py-3 rounded-lg transition-all shadow-lg shadow-[#e51414]/20">
      Create Account
    </button>

    <p class="text-center text-sm text-gray-500">
      Already have an account?
      <a href="/login" class="text-[#e51414] hover:text-[#ff2a2a] font-medium transition-colors">Log in</a>
    </p>

  </form>
</div>

</div>
</body>

</html>
