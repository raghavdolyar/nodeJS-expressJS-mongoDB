<%- include('../partials/head') %>

<%
  const errors = validationErrors || [];
  const fieldError = (path) => errors.find(err => err.path === path)?.msg;
  const input = oldInput || {};
  const inputClass = (path) =>
    'bg-[#111114] text-white text-sm px-4 py-2.5 rounded-lg border focus:outline-none focus:border-[#e51414] focus:ring-1 focus:ring-[#e51414]/30 transition-colors placeholder-gray-600 ' +
    (fieldError(path) ? 'border-[#e51414]/70' : 'border-[#2a2a2f]');
%>

<div class="w-full max-w-sm mt-10">
  <h2 class="text-2xl font-bold text-white mb-6 text-center">Welcome <span class="text-[#e51414]">Back</span></h2>

  <%- include('../partials/validation-errors') %>

  <form action="/login" method="POST" class="bg-[#1a1a1f] rounded-xl p-8 flex flex-col gap-4 shadow-lg">

    <%- include('../partials/form-field', {
      id: 'email',
      name: 'email',
      label: 'Email',
      type: 'email',
      placeholder: 'you@example.com',
      value: input.email || '',
      inputClass: inputClass('email'),
      errorMsg: fieldError('email'),
      autocomplete: 'email',
      required: true
    }) %>

    <%- include('../partials/form-field', {
      id: 'password',
      name: 'password',
      label: 'Password',
      type: 'password',
      placeholder: '••••••••',
      inputClass: inputClass('password'),
      errorMsg: fieldError('password'),
      autocomplete: 'current-password',
      required: true
    }) %>

    <button type="submit" class="mt-2 bg-[#e51414] hover:bg-[#c10d0d] text-white text-sm font-semibold py-2.5 rounded-lg transition-colors">
      Log In
    </button>

    <p class="text-center text-sm text-gray-500">
      Don't have an account?
      <a href="/signup" class="text-[#e51414] hover:text-[#ff2a2a] font-medium transition-colors">Sign up</a>
    </p>

  </form>
</div>

</div>
</body>

</html>
