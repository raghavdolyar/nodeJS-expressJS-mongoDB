<%- include('../partials/head') %>

<%
  const errors     = validationErrors || [];
  const fieldError = (path) => errors.find(e => e.path === path)?.msg;
  const input      = oldInput || {};
  const inputClass = (path) =>
    'bg-gray-50 dark:bg-[#111114] text-gray-900 dark:text-white text-sm px-4 py-2.5 rounded-lg border focus:outline-none focus:border-[#D6001C] focus:ring-1 focus:ring-[#D6001C]/20 transition-colors placeholder-gray-400 dark:placeholder-gray-600 w-full ' +
    (fieldError(path) ? 'border-red-400 dark:border-red-500/70' : 'border-gray-200 dark:border-[#2a2a2f]');
%>

<div class="w-full max-w-4xl mx-auto px-4 sm:px-6 pb-20">

  <%# Back link %>
  <div class="mb-8">
    <a href="/homes/<%= home._id %>" class="inline-flex items-center gap-2 text-gray-400 hover:text-gray-700 dark:hover:text-white text-sm font-medium transition-all duration-200">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="h-4 w-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
      </svg>
      Back to home details
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">

    <%# ── Left: home summary card ── %>
    <div class="bg-white dark:bg-[#161618] border border-gray-200 dark:border-white/8 rounded-2xl overflow-hidden shadow-sm dark:shadow-lg">

      <div class="relative overflow-hidden">
        <img src="<%= home.photo_url %>" alt="<%= home.name %>" class="w-full h-52 object-cover" />
        <div class="absolute top-3 right-3 inline-flex items-center gap-1
                    bg-white/90 dark:bg-black/70 text-amber-500 text-xs font-semibold
                    px-2.5 py-1 rounded-lg backdrop-blur-sm">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5">
            <path fill-rule="evenodd" d="M10.788 3.21c.448-1.064 1.12-1.064 1.568 0l2.759 6.536 7.058.588c1.164.097 1.636 1.545.749 2.305l-5.365 4.749 1.634 6.873c.271 1.14-.946 2.033-1.92 1.433L12 18.98l-6.271 3.704c-.974.6-2.19-.294-1.92-1.433l1.634-6.873-5.365-4.749c-.887-.76-.415-2.208.749-2.305l7.058-.588 2.759-6.536z" clip-rule="evenodd" />
          </svg>
          <%= home.rating %>
        </div>
      </div>

      <div class="p-5 flex flex-col gap-3">
        <div>
          <h2 class="text-gray-900 dark:text-white font-bold text-xl leading-snug"><%= home.name %></h2>
          <p class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500 text-sm mt-1">
            <svg class="w-3.5 h-3.5 text-[#D6001C] shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z" />
            </svg>
            <%= home.location %>
          </p>
        </div>

        <div class="border-t border-gray-100 dark:border-white/6 pt-3 flex items-center justify-between">
          <div>
            <p class="text-gray-400 dark:text-gray-500 text-xs font-medium uppercase tracking-wide">Price</p>
            <p class="text-gray-900 dark:text-white text-2xl font-bold mt-0.5">
              $<%= home.price_per_night %>
              <span class="text-gray-400 dark:text-gray-500 text-sm font-normal">/ night</span>
            </p>
          </div>

          <%# Live total — updates as dates change %>
          <div class="text-right" id="totalBox" style="display:none;">
            <p class="text-gray-400 dark:text-gray-500 text-xs font-medium uppercase tracking-wide">Total</p>
            <p class="text-gray-900 dark:text-white text-2xl font-bold mt-0.5" id="totalDisplay">—</p>
          </div>
        </div>
      </div>
    </div>

    <%# ── Right: booking form ── %>
    <div>
      <p class="text-[#D6001C] text-xs font-semibold uppercase tracking-widest mb-2">Reserve</p>
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-1 tracking-tight">
        Book your stay
      </h1>
      <p class="text-gray-400 dark:text-gray-500 text-sm mb-7">
        Pick your check-in and check-out dates below.
      </p>

      <%- include('../partials/validation-errors') %>

      <form action="/homes/<%= home._id %>/book" method="POST" data-price="<%= home.price_per_night %>" class="bg-white dark:bg-[#1a1a1f] rounded-2xl p-7 flex flex-col gap-5
               shadow-sm dark:shadow-xl border border-gray-100 dark:border-white/6">

        <%# Check-in %>
        <div class="flex flex-col gap-1.5">
          <label for="checkIn" class="text-sm text-gray-600 dark:text-gray-400 font-medium">Check-in</label>
          <input type="date" id="checkIn" name="checkIn" value="<%= input.checkIn || '' %>" class="<%= inputClass('checkIn') %>" required />
          <% if (fieldError('checkIn')) { %>
          <p class="text-xs text-red-500 dark:text-red-400"><%= fieldError('checkIn') %></p>
          <% } %>
        </div>

        <%# Check-out %>
        <div class="flex flex-col gap-1.5">
          <label for="checkOut" class="text-sm text-gray-600 dark:text-gray-400 font-medium">Check-out</label>
          <input type="date" id="checkOut" name="checkOut" value="<%= input.checkOut || '' %>" class="<%= inputClass('checkOut') %>" required />
          <% if (fieldError('checkOut')) { %>
          <p class="text-xs text-red-500 dark:text-red-400"><%= fieldError('checkOut') %></p>
          <% } %>
        </div>

        <%# Hidden field — total price computed by JS, sent with form %>
        <input type="hidden" id="totalPrice" name="totalPrice" value="<%= input.totalPrice || '' %>" />

        <%# Summary strip — hidden until dates selected %>
        <div id="summaryStrip" class="hidden items-center justify-between bg-gray-50 dark:bg-[#111114]
                 border border-gray-200 dark:border-white/8 rounded-xl px-4 py-3 text-sm">
          <span class="text-gray-500 dark:text-gray-400" id="nightsLabel"></span>
          <span class="text-gray-900 dark:text-white font-semibold" id="stripTotal"></span>
        </div>

        <button type="submit" class="mt-1 bg-[#22c55e] hover:bg-[#16a34a] active:scale-[0.98] text-white text-sm font-semibold
                 py-3 rounded-lg transition-all shadow-sm flex items-center justify-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="h-4 w-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
          </svg>
          Confirm Booking
        </button>

      </form>
    </div>

  </div>
</div>

<%# ── Live price calculator ── %>
<script>
  (function() {
    const pricePerNight = parseFloat(document.querySelector('form[data-price]').dataset.price);
    const checkInEl = document.getElementById('checkIn');
    const checkOutEl = document.getElementById('checkOut');
    const totalPriceEl = document.getElementById('totalPrice');
    const totalBox = document.getElementById('totalBox');
    const totalDisplay = document.getElementById('totalDisplay');
    const summaryStrip = document.getElementById('summaryStrip');
    const nightsLabel = document.getElementById('nightsLabel');
    const stripTotal = document.getElementById('stripTotal');

    // Set min date to today so past dates can't be picked
    const today = new Date().toISOString().split('T')[0];
    checkInEl.min = today;
    checkOutEl.min = today;

    function recalc() {
      const inVal = checkInEl.value;
      const outVal = checkOutEl.value;

      if (!inVal || !outVal) {
        totalBox.style.display = 'none';
        summaryStrip.classList.add('hidden');
        totalPriceEl.value = '';
        return;
      }

      const inDate = new Date(inVal);
      const outDate = new Date(outVal);
      const nights = Math.round((outDate - inDate) / (1000 * 60 * 60 * 24));

      if (nights <= 0) {
        totalBox.style.display = 'none';
        summaryStrip.classList.add('hidden');
        totalPriceEl.value = '';
        // Push checkout past checkin if user picks bad combo
        checkOutEl.min = new Date(inDate.getTime() + 86400000).toISOString().split('T')[0];
        return;
      }

      const total = (nights * pricePerNight).toFixed(2);

      // Update hidden input
      totalPriceEl.value = total;

      // Update left card total
      totalBox.style.display = '';
      totalDisplay.textContent = '$' + parseFloat(total).toLocaleString();

      // Update summary strip
      summaryStrip.classList.remove('hidden');
      nightsLabel.textContent = nights + (nights === 1 ? ' night' : ' nights') + ' × $' + pricePerNight;
      stripTotal.textContent = '$' + parseFloat(total).toLocaleString();

      // Push checkout min forward
      checkOutEl.min = new Date(inDate.getTime() + 86400000).toISOString().split('T')[0];
    }

    checkInEl.addEventListener('change', recalc);
    checkOutEl.addEventListener('change', recalc);

    // Restore on validation re-render
    recalc();
  })();
</script>

</div>
</body>

</html>