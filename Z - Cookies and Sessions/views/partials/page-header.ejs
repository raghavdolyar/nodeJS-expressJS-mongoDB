<header class="w-full max-w-6xl mx-auto mb-10 text-center px-4">
  <% if (typeof eyebrow !== 'undefined' && eyebrow) { %>
    <p class="text-gray-400 dark:text-gray-500 text-xs font-semibold uppercase tracking-widest mb-2"><%= eyebrow %></p>
  <% } %>
  <h2 class="text-3xl sm:text-4xl font-semibold text-gray-900 dark:text-white tracking-tight">
    <%- titleHtml %>
  </h2>
  <% if (typeof subtitle !== 'undefined' && subtitle) { %>
    <p class="mt-3 text-gray-500 dark:text-gray-400 text-sm sm:text-base max-w-lg mx-auto leading-relaxed"><%= subtitle %></p>
  <% } %>
</header>
