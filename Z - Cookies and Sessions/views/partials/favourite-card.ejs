<div class="bg-white dark:bg-[#161618] border border-gray-200 dark:border-white/8 rounded-xl overflow-hidden w-full max-w-xs sm:max-w-none transition-all duration-200 group hover:shadow-md dark:hover:shadow-black/30 hover:border-gray-300 dark:hover:border-white/15">

  <div class="relative overflow-hidden">
    <img src="<%= home.photo_url %>" alt="<%= home.name %>" class="w-full h-44 object-cover transition-transform duration-300 group-hover:scale-105" />

    <div class="absolute top-2.5 right-2.5 flex gap-1.5 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
      <form action="/favourites/delete/<%= home._id %>" method="POST">
        <button class="p-1.5 rounded-lg bg-white/90 dark:bg-black/60 hover:bg-red-50 dark:hover:bg-red-500/20 text-gray-700 dark:text-white hover:text-red-600 dark:hover:text-red-400 backdrop-blur-sm transition-colors shadow-sm" title="Remove from favourites">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </form>
    </div>
  </div>

  <div class="p-4 flex flex-col gap-3">

    <div class="flex items-start justify-between gap-2">
      <h3 class="text-gray-900 dark:text-white text-[17px] font-semibold leading-snug">
        <%= home.name %>
      </h3>
      <span class="flex items-center gap-0.5 text-[13px] text-amber-500 shrink-0 mt-0.5">
        ★ <%= home.rating %>
      </span>
    </div>

    <div class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500 text-[12px]">
      <svg class="w-3.5 h-3.5 text-[#D6001C] shrink-0" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z" />
      </svg>
      <%= home.location %>
    </div>

    <div class="border-t border-gray-100 dark:border-white/6 pt-3 flex items-center justify-between gap-2">
      <span class="text-gray-900 dark:text-white text-sm font-semibold">
        $<%= home.price_per_night %> <span class="text-gray-400 dark:text-gray-500 text-xs font-normal">/ night</span>
      </span>
      <div class="flex items-center gap-1.5">
        <a href="/homes/<%= home._id %>" class="px-3 py-1.5 border border-[#3b82f6] text-[#3b82f6] hover:bg-blue-50 dark:hover:bg-blue-500/10 text-xs font-medium rounded-lg transition-all duration-200">
          View
        </a>
        <a href="#" class="px-3 py-1.5 bg-[#22c55e] hover:bg-[#16a34a] text-white text-xs font-medium rounded-lg transition-all duration-200 shadow-sm">
          Book
        </a>
      </div>
    </div>

  </div>
</div>