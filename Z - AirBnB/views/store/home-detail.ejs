<%- include('../partials/head') %>

<div class="max-w-4xl mx-auto px-4 py-10">

  <div class="bg-gray-900 rounded-2xl overflow-hidden shadow-2xl border border-gray-800">

    <div class="relative">
      <img src="<%= home.photoUrl %>" alt="<%= home.name %>" class="w-full h-80 object-cover" />
      <div class="absolute inset-0 bg-linear-to-t from-gray-900 via-transparent to-transparent"></div>

      <div class="absolute top-4 right-4 bg-red-600 text-white text-sm font-bold px-3 py-1 rounded-full flex items-center gap-1">
        ⭐ <%= home.rating %>
      </div>
    </div>

    <div class="p-8">

      <div class="mb-6">
        <h1 class="text-3xl font-bold text-white mb-2">
          <%= home.name %>
        </h1>
        <p class="text-gray-400 flex items-center gap-2 text-lg">
          📍 <%= home.location %>
        </p>
      </div>

      <hr class="border-gray-700 mb-6" />

      <div class="grid grid-cols-2 gap-6 mb-8">

        <div class="bg-gray-800 rounded-xl p-5">
          <p class="text-gray-400 text-sm mb-1">Price per night</p>
          <p class="text-white text-2xl font-bold">
            ₹<%= home.price %>
          </p>
        </div>

        <div class="bg-gray-800 rounded-xl p-5">
          <p class="text-gray-400 text-sm mb-1">Guest Rating</p>
          <p class="text-white text-2xl font-bold">
            <%= home.rating %> <span class="text-yellow-400">★</span>
          </p>
        </div>

        <div class="bg-gray-800 rounded-xl p-5">
          <p class="text-gray-400 text-sm mb-1">Location</p>
          <p class="text-white font-semibold">
            <%= home.location %>
          </p>
        </div>

        <div class="bg-gray-800 rounded-xl p-5">
          <p class="text-gray-400 text-sm mb-1">Home ID</p>
          <p class="text-white font-semibold">#<%= home.id %>
          </p>
        </div>

      </div>

      <div class="flex gap-4">
        <button class="flex-1 bg-red-600 hover:bg-red-700 text-white font-semibold py-3 rounded-xl transition duration-200">
          Book Now
        </button>
        <%- include('../partials/favourite.ejs', { home }) %>
      </div>

    </div>
  </div>

  <div class="mt-6 text-center">
    <a href="/homes" class="text-gray-400 hover:text-white text-sm transition duration-200">
      ← Back to all homes
    </a>
  </div>

</div>

</div>
</body>

</html>